# Copy to .env.local and fill in. Every variable is optional: with none set the
# site builds and runs from src/content/fallback/*.json and logs leads to the console.

# --- Sanity CMS ---------------------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Viewer token (read). Needed for draft previews and the seed script reads it too.
SANITY_API_READ_TOKEN=
# Editor token (write). Only used by `npm run seed:sanity`.
SANITY_API_WRITE_TOKEN=
# Shared secret for the /api/revalidate webhook.
SANITY_REVALIDATE_SECRET=

# --- Leads --------------------------------------------------------------------
# resend | hubspot | console   (defaults to resend when RESEND_API_KEY is set, else console)
LEAD_PROVIDER=
RESEND_API_KEY=
# Where lead notifications go.
LEAD_TO_EMAIL=
# Verified Resend sender, e.g. "JM Kelley Inc. <leads@jmkelleyinc.com>"
LEAD_FROM_EMAIL=
# Only for LEAD_PROVIDER=hubspot
HUBSPOT_WEBHOOK_URL=

# --- File uploads (Vercel Blob) -----------------------------------------------
# Created automatically when you add a Blob store to the Vercel project.
BLOB_READ_WRITE_TOKEN=

# --- Site ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set to "true" before launch to hide TODO(client) placeholder markers.
NEXT_PUBLIC_HIDE_TODOS=
